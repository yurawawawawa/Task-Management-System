# Copy this file to `.env.local` and replace every placeholder with real values.
# Do not commit `.env` or `.env.local`.

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
DIRECT_URL="postgresql://user:password@localhost:5432/mydb"

# Enable only AFTER applying migrations/admin-control-center.sql.
# Server-only switch; never use a NEXT_PUBLIC_ variable for admin configuration.
TREKLY_ADMIN_TELEMETRY_ENABLED="false"
