// Taskora — Phase 1 MVP Database Schema
// Database: Supabase PostgreSQL
// Auth: Supabase Auth (auth.users managed by Supabase)
// use prisma-8

// ============================================
// Profile
// ============================================
// Extends Supabase auth.users with application data.
// The `id` matches auth.users.id (UUID from Supabase Auth).
// We don't store passwords — Supabase handles that.

model Profile {
  id        Uuid     @id
  name      String
  email     String   @unique
  createdAt TimestamptzString @default(now()) @map("created_at")
  updatedAt temporal.updatedAtString() @map("updated_at")

  // Relations
  projects        Project[]
  tasks           Task[]         @relation("UserTasks")
  assignedTasks   Task[]         @relation("AssignedTasks")
  projectMembers  ProjectMember[]

  @@map("profiles")
  @@rls
}

// ============================================
// Project
// ============================================

model Project {
  id          Uuid     @id @default(uuid())
  userId      Uuid     @map("user_id")
  name        String
  description String?
  createdAt   TimestamptzString @default(now()) @map("created_at")
  updatedAt   temporal.updatedAtString() @map("updated_at")

  // Relations
  user    Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks   Task[]
  members ProjectMember[]

  // Indexes
  @@index([userId])
  @@map("projects")
  @@rls
}

// ============================================
// Project Member
// ============================================

model ProjectMember {
  id        Uuid     @id @default(uuid())
  projectId Uuid     @map("project_id")
  profileId Uuid     @map("profile_id")
  role      String   @default("MEMBER")
  createdAt TimestamptzString @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([projectId, profileId])
  @@index([projectId])
  @@index([profileId])
  @@map("project_members")
  @@rls
}

// ============================================
// Task
// ============================================

model Task {
  id          Uuid         @id @default(uuid())
  userId      Uuid         @map("user_id")
  projectId   Uuid?        @map("project_id")
  assigneeId  Uuid?        @map("assignee_id")
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     TimestamptzString? @map("due_date")
  createdAt   TimestamptzString @default(now()) @map("created_at")
  updatedAt   temporal.updatedAtString() @map("updated_at")

  // Relations
  user     Profile  @relation("UserTasks", fields: [userId], references: [id], onDelete: Cascade)
  assignee Profile? @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([userId])
  @@index([userId, status])
  @@index([userId, priority])
  @@index([projectId])
  @@map("tasks")
  @@rls
}

// ============================================
// Enums
// ============================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
