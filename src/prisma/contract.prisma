// Trekly — Phase 1 MVP Database Schema
// Database: Supabase PostgreSQL
// Auth: Supabase Auth (auth.users managed by Supabase)
// use prisma-8

// ============================================
// Profile
// ============================================
// Extends Supabase auth.users with application data.
// The `id` matches auth.users.id (UUID from Supabase Auth).
// We don't store passwords — Supabase handles that.

model Profile {
  id        Uuid     @id
  name      String
  email     String   @unique
  createdAt TimestamptzString @default(now()) @map("created_at")
  updatedAt temporal.updatedAtString() @map("updated_at")

  // Relations
  projects        Project[]
  tasks           Task[]         @relation("UserTasks")
  assignedTasks   Task[]         @relation("AssignedTasks")
  projectMembers  ProjectMember[]
  dailyActivities DailyActivity[]
  habits          Habit[]

  @@map("profiles")
  @@rls
}

// ============================================
// Project
// ============================================

model Project {
  id          Uuid     @id @default(uuid())
  userId      Uuid     @map("user_id")
  name        String
  description String?
  createdAt   TimestamptzString @default(now()) @map("created_at")
  updatedAt   temporal.updatedAtString() @map("updated_at")

  // Relations
  user    Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks   Task[]
  members ProjectMember[]
  invites ProjectInvite[]

  // Indexes
  @@index([userId])
  @@map("projects")
  @@rls
}

// ============================================
// Project Member
// ============================================

model ProjectMember {
  id        Uuid     @id @default(uuid())
  projectId Uuid     @map("project_id")
  profileId Uuid     @map("profile_id")
  role      String   @default("MEMBER")
  createdAt TimestamptzString @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([projectId, profileId])
  @@index([projectId])
  @@index([profileId])
  @@map("project_members")
  @@rls
}

// ============================================
// Task
// ============================================

model Task {
  id          Uuid         @id @default(uuid())
  userId      Uuid         @map("user_id")
  projectId   Uuid?        @map("project_id")
  assigneeId  Uuid?        @map("assignee_id")
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     TimestamptzString? @map("due_date")
  createdAt   TimestamptzString @default(now()) @map("created_at")
  updatedAt   temporal.updatedAtString() @map("updated_at")

  // Relations
  user     Profile  @relation("UserTasks", fields: [userId], references: [id], onDelete: Cascade)
  assignee Profile? @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([userId])
  @@index([userId, status])
  @@index([userId, priority])
  @@index([projectId])
  @@map("tasks")
  @@rls
}

// ============================================
// Enums
// ============================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ============================================
// Daily Activity
// ============================================

model DailyActivity {
  id            Uuid              @id @default(uuid())
  userId        Uuid              @map("user_id")
  date          String            @map("date")
  taskCount     Int               @default(0) @map("task_count")
  streakCounted Boolean           @default(false) @map("streak_counted")
  createdAt     TimestamptzString @default(now()) @map("created_at")
  updatedAt     temporal.updatedAtString() @map("updated_at")

  // Relations
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes
  @@unique([userId, date])
  @@index([userId])
  @@index([userId, date])
  @@map("daily_activities")
  @@rls
}

// ============================================
// Project Invite / Share Link
// ============================================

model ProjectInvite {
  id         Uuid              @id @default(uuid())
  projectId  Uuid              @map("project_id")
  email      String?
  tokenHash  String            @unique @map("token_hash")
  expiresAt  TimestamptzString @default(now()) @map("expires_at")
  acceptedAt TimestamptzString? @map("accepted_at")
  createdAt  TimestamptzString @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([email])
  @@map("project_invites")
  @@rls
}

// ============================================
// Habits
// ============================================

model Habit {
  id          Uuid              @id @default(uuid())
  userId      Uuid              @map("user_id")
  title       String
  category    String            @default("Produktivitas")
  frequency   String            @default("DAILY")
  createdAt   TimestamptzString @default(now()) @map("created_at")
  updatedAt   temporal.updatedAtString() @map("updated_at")

  user        Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]

  @@index([userId])
  @@map("habits")
  @@rls
}

model HabitCompletion {
  id          Uuid              @id @default(uuid())
  habitId     Uuid              @map("habit_id")
  date        String
  completedAt TimestamptzString @default(now()) @map("completed_at")

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId, date])
  @@map("habit_completions")
  @@rls
}
