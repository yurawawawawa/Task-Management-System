// Prisma schema for Trekly — Phase 1 MVP
// Database: Supabase PostgreSQL
// Auth: Supabase Auth (auth.users managed by Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// Profile
// ============================================
// Extends Supabase auth.users with application data.
// The `id` matches auth.users.id (UUID from Supabase Auth).
// We don't store passwords — Supabase handles that.

model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  projects        Project[]
  tasks           Task[]         @relation("UserTasks")
  assignedTasks   Task[]         @relation("AssignedTasks")
  projectMembers  ProjectMember[]

  @@map("profiles")
}

// ============================================
// Project
// ============================================

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user    Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks   Task[]
  members ProjectMember[]

  // Indexes
  @@index([userId])
  @@map("projects")
}

// ============================================
// Project Member
// ============================================

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  role      String   @default("MEMBER")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([projectId, profileId])
  @@index([projectId])
  @@index([profileId])
  @@map("project_members")
}

// ============================================
// Task
// ============================================

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  projectId   String?      @map("project_id") @db.Uuid
  assigneeId  String?      @map("assignee_id") @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  user     Profile  @relation("UserTasks", fields: [userId], references: [id], onDelete: Cascade)
  assignee Profile? @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Indexes — based on expected query patterns:
  // - List tasks by user (dashboard, task list)
  // - Filter by status/priority (filtered views)
  // - List tasks in a project (project detail)
  @@index([userId])
  @@index([userId, status])
  @@index([userId, priority])
  @@index([projectId])
  @@map("tasks")
}

// ============================================
// Enums
// ============================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
