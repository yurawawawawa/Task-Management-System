// Prisma schema for Taskora — Phase 1 MVP
// Database: Supabase PostgreSQL
// Auth: Supabase Auth (auth.users managed by Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// Profile
// ============================================
// Extends Supabase auth.users with application data.
// The `id` matches auth.users.id (UUID from Supabase Auth).
// We don't store passwords — Supabase handles that.

model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  projects Project[]
  tasks    Task[]

  @@map("profiles")
}

// ============================================
// Project
// ============================================
// A project belongs to one user and can contain multiple tasks.
// When a project is deleted, all its tasks are cascade deleted.

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user  Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  // Indexes
  @@index([userId])
  @@map("projects")
}

// ============================================
// Task
// ============================================
// A task belongs to one user and optionally to a project.
// Task has userId directly for fast ownership queries
// without needing to JOIN through projects.

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  projectId   String?      @map("project_id") @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  user    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Indexes — based on expected query patterns:
  // - List tasks by user (dashboard, task list)
  // - Filter by status/priority (filtered views)
  // - List tasks in a project (project detail)
  @@index([userId])
  @@index([userId, status])
  @@index([userId, priority])
  @@index([projectId])
  @@map("tasks")
}

// ============================================
// Enums
// ============================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
